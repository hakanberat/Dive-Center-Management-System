@model IEnumerable<DiveCenterManager.ViewModels.ReservationListItemViewModel>

@{
    ViewData["Title"] = "Reservations";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Reservations</h1>

        <p class="text-muted mb-0">
            Manage dive center reservations.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        New Reservation
    </a>

</div>

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm">

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No reservations found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Activity</th>
                            <th>Dive Site</th>
                            <th>Boat</th>
                            <th>Staff</th>
                            <th>Participants</th>
                            <th>Status</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reservation in Model)
                        {
                            <tr>

                                <td>
                                    @reservation.ReservationDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @reservation.StartTime.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    <strong>
                                        @reservation.ActivityName
                                    </strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(reservation.DiveSiteName)
                                        ? "-"
                                        : reservation.DiveSiteName)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(reservation.BoatName)
                                        ? "-"
                                        : reservation.BoatName)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(reservation.StaffName)
                                        ? "-"
                                        : reservation.StaffName)
                                </td>

                                <td>
                                    @reservation.ParticipantCount
                                </td>

                                <td>

                                    @switch (reservation.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                            break;

                                        case "Confirmed":
                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>
                                            break;

                                        case "Completed":
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                            break;

                                        case "Cancelled":
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                            break;

                                        case "NoShow":
                                            <span class="badge bg-danger">
                                                No Show
                                            </span>
                                            break;
                                    }

                                </td>

                                <td class="text-end">

                                    <strong>
                                        @reservation.TotalAmount.ToString("N2")
                                        @reservation.CurrencyCode
                                    </strong>

                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@reservation.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (reservation.Status == "Pending")
                                    {
                                        <form asp-action="SetStatus"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Confirmed" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">
                                                Confirm
                                            </button>

                                        </form>

                                        <form asp-action="SetStatus"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Cancel this reservation?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Cancelled" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Cancel
                                            </button>

                                        </form>
                                    }

                                    @if (reservation.Status == "Confirmed")
                                    {
                                        <form asp-action="SetStatus"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Completed" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Complete
                                            </button>

                                        </form>

                                        <form asp-action="SetStatus"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Mark this reservation as No Show?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="NoShow" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning">
                                                No Show
                                            </button>

                                        </form>

                                        <form asp-action="SetStatus"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Cancel this reservation?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Cancelled" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Cancel
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>