@model DiveCenterManager.ViewModels.TransactionCreateViewModel

@{
    ViewData["Title"] = "New Transaction";
}

<h1>New Transaction</h1>

<p class="text-muted">
    Record an income or expense transaction.
</p>

<hr />

<div class="row">

    <div class="col-lg-7">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="TransactionDate"
                       class="form-label">
                    Date
                </label>

                <input asp-for="TransactionDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="TransactionDate"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="CategoryId"
                       class="form-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        class="form-select">

                    <option value="0">
                        Select category
                    </option>

                    @foreach (var category in Model.AvailableCategories)
                    {
                        <option value="@category.Id">
                            @category.Type - @category.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Amount"
                           class="form-label">
                        Amount
                    </label>

                    <input asp-for="Amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control" />

                    <span asp-validation-for="Amount"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="CurrencyId"
                           class="form-label">
                        Currency
                    </label>

                    <select asp-for="CurrencyId"
                            class="form-select">

                        <option value="0">
                            Select currency
                        </option>

                        @foreach (var currency in Model.AvailableCurrencies)
                        {
                            <option value="@currency.Id">
                                @currency.Code - @currency.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CurrencyId"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mb-4">

                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>