@model IEnumerable<DiveCenterManager.ViewModels.TransactionListItemViewModel>

@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Transactions</h1>

        <p class="text-muted mb-0">
            Manage dive center income and expenses.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        New Transaction
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No transactions found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th>Currency</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var transaction in Model)
                        {
                            <tr>

                                <td>
                                    @transaction.TransactionDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <strong>
                                        @transaction.CategoryName
                                    </strong>
                                </td>

                                <td>
                                    @if (transaction.Type == "Income")
                                    {
                                        <span class="badge bg-success">
                                            Income
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Expense
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    @transaction.Amount.ToString("N2")
                                </td>

                                <td>
                                    <strong>
                                        @transaction.CurrencyCode
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(transaction.CurrencySymbol))
                                    {
                                        <span class="text-muted">
                                            (@transaction.CurrencySymbol)
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(transaction.Description)
                                        ? "-"
                                        : transaction.Description)
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@transaction.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this transaction?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@transaction.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>