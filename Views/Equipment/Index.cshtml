@model IEnumerable<DiveCenterManager.Models.Equipment>

@{
    ViewData["Title"] = "Equipment";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Equipment</h1>

        <p class="text-muted mb-0">
            Manage dive center equipment.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        New Equipment
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="row g-2 mb-4">

            <div class="col-md-5">

                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search equipment..." />

            </div>

            <div class="col-auto">

                <button type="submit"
                        class="btn btn-outline-primary">
                    Search
                </button>

            </div>

            <div class="col-auto">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear
                </a>

            </div>

        </form>

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No equipment found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Brand</th>
                            <th>Model</th>
                            <th>Serial Number</th>
                            <th>Quantity</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Category)
                                        ? "-"
                                        : item.Category)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Brand)
                                        ? "-"
                                        : item.Brand)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Model)
                                        ? "-"
                                        : item.Model)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.SerialNumber)
                                        ? "-"
                                        : item.SerialNumber)
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="ToggleActiveStatus"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        @if (item.IsActive)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>
                                        }

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>