@model DiveCenterManager.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Dashboard</h1>

        <p class="text-muted mb-0">
            Dive center operational overview.
        </p>
    </div>

    <a asp-controller="Reservations"
       asp-action="Create"
       class="btn btn-primary">
        New Reservation
    </a>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <div class="text-muted">
                    Today's Reservations
                </div>

                <div class="display-6 fw-bold">
                    @Model.TodayReservationCount
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <div class="text-muted">
                    Pending Reservations
                </div>

                <div class="display-6 fw-bold">
                    @Model.PendingReservationCount
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <div class="text-muted">
                    Confirmed Reservations
                </div>

                <div class="display-6 fw-bold">
                    @Model.ConfirmedReservationCount
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <div class="text-muted">
                    Active Staff
                </div>

                <div class="display-6 fw-bold">
                    @Model.ActiveStaffCount
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <div class="text-muted">
                    Active Boats
                </div>

                <div class="display-6 fw-bold">
                    @Model.ActiveBoatCount
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <div class="text-muted">
                    Active Equipment
                </div>

                <div class="display-6 fw-bold">
                    @Model.ActiveEquipmentCount
                </div>

            </div>
        </div>
    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <strong>
                Today's Reservations
            </strong>

            <a asp-controller="Calendar"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                Open Calendar
            </a>

        </div>

    </div>

    <div class="card-body">

        @if (!Model.TodayReservations.Any())
        {
            <div class="alert alert-info mb-0">
                No reservations scheduled for today.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Activity</th>
                            <th>Dive Site</th>
                            <th>Boat</th>
                            <th>Staff</th>
                            <th>Participants</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reservation in Model.TodayReservations)
                        {
                            <tr>

                                <td>
                                    @reservation.StartTime.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    <strong>
                                        @reservation.ActivityName
                                    </strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(reservation.DiveSiteName)
                                        ? "-"
                                        : reservation.DiveSiteName)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(reservation.BoatName)
                                        ? "-"
                                        : reservation.BoatName)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(reservation.StaffName)
                                        ? "-"
                                        : reservation.StaffName)
                                </td>

                                <td>
                                    @reservation.ParticipantCount
                                </td>

                                <td>

                                    @switch (reservation.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                            break;

                                        case "Confirmed":
                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>
                                            break;

                                        case "Completed":
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                            break;
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-controller="Reservations"
                                       asp-action="Edit"
                                       asp-route-id="@reservation.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>