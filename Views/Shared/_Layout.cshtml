@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var pageTitle =
        ViewData["Title"]?.ToString() ?? "Management System";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @pageTitle - Dive Hub Management System
    </title>

    <link rel="icon"
          type="image/png"
          href="~/images/divehub-logo.png" />

    <link rel="apple-touch-icon"
          href="~/images/divehub-logo.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="app-sidebar"
               id="appSidebar">

            @if (User.IsInRole("Admin"))
            {
                <a class="sidebar-brand"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <img src="~/images/divehub-logo.png"
                         alt="Dive Hub"
                         class="sidebar-logo" />

                    <span class="sidebar-brand-text">

                        <span class="sidebar-brand-title">
                            Dive Hub
                        </span>

                        <span class="sidebar-brand-subtitle">
                            Management System
                        </span>

                    </span>

                </a>
            }
            else
            {
                <a class="sidebar-brand"
                   asp-controller="Reservations"
                   asp-action="Index">

                    <img src="~/images/divehub-logo.png"
                         alt="Dive Hub"
                         class="sidebar-logo" />

                    <span class="sidebar-brand-text">

                        <span class="sidebar-brand-title">
                            Dive Hub
                        </span>

                        <span class="sidebar-brand-subtitle">
                            Management System
                        </span>

                    </span>

                </a>
            }

            <nav class="sidebar-navigation">

                <!-- MAIN -->
                <div class="sidebar-section-title">
                    Main
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">

                        <i class="bi bi-speedometer2 sidebar-icon"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>
                }

                <a asp-controller="Reservations"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Reservations" ? "active" : "")">

                    <i class="bi bi-calendar-check sidebar-icon"></i>

                    <span>
                        Reservations
                    </span>

                </a>

                <a asp-controller="Calendar"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Calendar" ? "active" : "")">

                    <i class="bi bi-calendar3 sidebar-icon"></i>

                    <span>
                        Calendar
                    </span>

                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Reports" ? "active" : "")">

                        <i class="bi bi-bar-chart sidebar-icon"></i>

                        <span>
                            Reports
                        </span>

                    </a>


                    <!-- MANAGEMENT -->

                    <div class="sidebar-section-title">
                        Management
                    </div>

                    <a asp-controller="Activities"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Activities" ? "active" : "")">

                        <i class="bi bi-activity sidebar-icon"></i>

                        <span>
                            Activities
                        </span>

                    </a>

                    <a asp-controller="DiveSites"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "DiveSites" ? "active" : "")">

                        <i class="bi bi-geo-alt sidebar-icon"></i>

                        <span>
                            Dive Sites
                        </span>

                    </a>

                    <a asp-controller="Staff"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Staff" ? "active" : "")">

                        <i class="bi bi-person-workspace sidebar-icon"></i>

                        <span>
                            Staff
                        </span>

                    </a>

                    <a asp-controller="Roles"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Roles" ? "active" : "")">

                        <i class="bi bi-person-badge sidebar-icon"></i>

                        <span>
                            Roles
                        </span>

                    </a>

                    <a asp-controller="Boats"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Boats" ? "active" : "")">

                        <i class="bi bi-water sidebar-icon"></i>

                        <span>
                            Boats
                        </span>

                    </a>

                    <a asp-controller="Equipment"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Equipment" ? "active" : "")">

                        <i class="bi bi-tools sidebar-icon"></i>

                        <span>
                            Equipment
                        </span>

                    </a>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Users" ? "active" : "")">

                        <i class="bi bi-people sidebar-icon"></i>

                        <span>
                            Users
                        </span>

                    </a>


                    <!-- FINANCE -->

                    <div class="sidebar-section-title">
                        Finance
                    </div>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Transactions" ? "active" : "")">

                        <i class="bi bi-cash-stack sidebar-icon"></i>

                        <span>
                            Transactions
                        </span>

                    </a>

                    <a asp-controller="TransactionCategories"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "TransactionCategories" ? "active" : "")">

                        <i class="bi bi-tags sidebar-icon"></i>

                        <span>
                            Transaction Categories
                        </span>

                    </a>

                    <a asp-controller="Currencies"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Currencies" ? "active" : "")">

                        <i class="bi bi-currency-exchange sidebar-icon"></i>

                        <span>
                            Currencies
                        </span>

                    </a>
                }

            </nav>

        </aside>


        <!-- MOBILE OVERLAY -->
        <div class="sidebar-overlay"
             id="sidebarOverlay">
        </div>


        <!-- MAIN AREA -->
        <div class="app-main">

            <!-- HEADER -->
            <header class="app-header">

                <div class="app-header-left">

                    <button type="button"
                            class="mobile-menu-button"
                            id="mobileMenuButton"
                            aria-label="Open navigation"
                            aria-controls="appSidebar"
                            aria-expanded="false">

                        <i class="bi bi-list"></i>

                    </button>

                    <h1 class="app-header-title">
                        @pageTitle
                    </h1>

                </div>

                <div class="app-user">

                    <div class="text-end app-user-details">

                        <div class="app-user-name">
                            @User.FindFirst("DisplayName")?.Value
                        </div>

                        <small class="text-muted">

                            @if (User.IsInRole("Admin"))
                            {
                                <span>
                                    Administrator
                                </span>
                            }
                            else
                            {
                                <span>
                                    User
                                </span>
                            }

                        </small>

                    </div>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm">

                            <i class="bi bi-box-arrow-right me-1"></i>

                            <span class="logout-text">
                                Logout
                            </span>

                        </button>

                    </form>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="app-content">

                @RenderBody()

            </main>

        </div>

    </div>
}
else
{
    <!-- LOGIN / SETUP PAGES -->

    <div class="container py-5">

        <div class="text-center mb-4">

            <img src="~/images/divehub-logo.png"
                 alt="Dive Hub"
                 style="width: 95px; height: 95px; object-fit: contain;" />

            <h1 class="h4 mt-3 mb-1">
                Dive Hub
            </h1>

            <div class="text-muted">
                Management System
            </div>

        </div>

        <main>
            @RenderBody()
        </main>

    </div>
}


<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

@await RenderSectionAsync(
    "Scripts",
    required: false)

</body>

</html>