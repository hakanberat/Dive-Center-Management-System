@model IEnumerable<DiveCenterManager.Models.DiveActivity>

@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Activities</h1>
        <p class="text-muted mb-0">
            Manage diving activities and prices.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        New Activity
    </a>
</div>

<form method="get"
      asp-action="Index"
      class="row g-2 mb-4">

    <div class="col-md-5">
        <input type="text"
               name="searchTerm"
               value="@ViewBag.SearchTerm"
               class="form-control"
               placeholder="Search by name or description..." />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn btn-outline-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Clear
        </a>
    </div>

</form>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No activities found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Currency</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var activity in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@activity.Name</strong>
                                </td>

                                <td>
                                    @activity.DefaultPrice.ToString("0.00")
                                </td>

                                <td>
                                    @activity.CurrencyCode
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(activity.Description)
                                        ? "-"
                                        : activity.Description)
                                </td>

                                <td>
                                    @if (activity.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@activity.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (activity.IsActive)
                                    {
                                        <form asp-action="SetActiveStatus"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@activity.Id" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="false" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="SetActiveStatus"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@activity.Id" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="true" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>